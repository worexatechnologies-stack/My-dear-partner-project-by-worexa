# Copy to .env and replace every CHANGE_ME value before deployment.
DJANGO_ENV=production
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
DB_NAME=matiromony
DB_USER=matiromony_app
DB_PASSWORD=CHANGE_ME_use_a_unique_database_password
ALLOWED_HOSTS=mydearpartner.com,www.mydearpartner.com,backend,nextjs,nginx

APP_NAME=My Dear Partner
APP_URL=https://mydearpartner.com
FRONTEND_URL=https://mydearpartner.com
BACKEND_URL=https://mydearpartner.com
CORS_ALLOWED_ORIGINS=https://mydearpartner.com,https://www.mydearpartner.com
CSRF_TRUSTED_ORIGINS=https://mydearpartner.com,https://www.mydearpartner.com
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME_use_an_app_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@mydearpartner.com
CONTACT_ENQUIRY_RECIPIENT=support@mydearpartner.com

OTP_PROVIDER=renflair
SMS_PROVIDER=renflair
RENFLAIR_API_KEY=CHANGE_ME

PAYMENT_MODE=razorpay
MEMBERSHIP_ACTIVATION_MODE=payment_verified
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

ENABLE_ADMIN_PORTAL=True
ENABLE_TWO_FACTOR=True
ENABLE_DEVELOPMENT_SEED=False
ENABLE_DEBUG_TOOLBAR=False
ENABLE_SWAGGER=False
ENABLE_API_DOCS=False
USE_S3=True
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_STORAGE_BUCKET_NAME=CHANGE_ME
AWS_REGION=ap-south-1

NEXT_PUBLIC_APP_NAME=My Dear Partner
NEXT_PUBLIC_APP_URL=https://mydearpartner.com
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_WS_BASE_URL=wss://mydearpartner.com
NEXT_PUBLIC_MEDIA_BASE_URL=https://mydearpartner.com/media
HTTP_PORT=80
